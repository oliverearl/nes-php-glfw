{
    "name": "oliverearl/nes-emulator",
    "description": "An NES emulator written in PHP using PHP-GLFW and the Visu game framework.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "type": "project",
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-glfw": "*",
        "phpgl/visu": "dev-master#c6addbcc681c2636fd463ce154dfba38d3abaa61",
        "larapack/dd": "^1.1"
    },
    "require-dev": {
      "laravel/pint": "^1.25",
      "phpgl/ide-stubs": "dev-main",
      "roave/security-advisories": "dev-latest",
      "phpunit/phpunit": "^12.5",
      "phpstan/phpstan": "^2.1",
      "rector/rector": "^2.2"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
        "test:integration": "@php vendor/bin/phpunit --testsuite=Integration",
        "test:coverage": "@php vendor/bin/phpunit --coverage-html=coverage",
        "benchmark": "@php bin/benchmark.php",
        "benchmark:help": "@php bin/benchmark.php --help",
        "pint": "@php vendor/bin/pint",
        "pint:check": "@php vendor/bin/pint --test",
        "phpstan": "@php -d memory_limit=512M vendor/bin/phpstan analyse",
        "phpstan:baseline": "@php -d memory_limit=512M vendor/bin/phpstan analyse --generate-baseline",
        "rector": "@php vendor/bin/rector process --dry-run",
        "rector:fix": [
            "@php vendor/bin/rector process",
            "@pint"
        ],
        "quality:check": [
            "@pint:check",
            "@phpstan",
            "@rector"
        ],
        "post-autoload-dump": [
            "ClanCats\\Container\\ComposerContainerFileLoader::generateMap"
        ]
    }
}
